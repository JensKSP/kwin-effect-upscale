# Observed at shutdown of Debian's KWin 6.3.6 virtual compositor: input filters
# and Wayland globals created before the test plugin loads survive teardown.
# Match allocation stacks, never whole libraries or the plugin's functions.
leak:KWin::KeyboardInputRedirection::init()
leak:KWin::OutputDeviceV2Interface::OutputDeviceV2Interface
leak:KWin::OutputInterface::OutputInterface
leak:KWin::XdgOutputManagerV1Interface::offer
leak:KWin::SeatInterface::SeatInterface
leak:KWin::WaylandServer::init()
# Trixie's shortcut registry retains application services at shutdown: a
# compositor run without any test effect reports the same 67 allocations
# (5118 bytes) from this startup stack as the instrumented effect sessions.
leak:GlobalShortcutsRegistry::loadSettings()
# KF6 Config 6.13 recreates watcher state during static shortcut destruction.
leak:KStandardShortcut::StandardShortcutWatcher::~StandardShortcutWatcher
# Each X11 client that crashes leaves Debian's KWin 6.3.6 holding a quick view
# and the pointing device made for it: a crashing glmark2 in a compositor run
# without any test effect reports the same 2152 and 16 bytes from these stacks
# per crash as the crash sessions (sessions.cmake, 2026-09-28).
leak:KWin::OffscreenQuickView::OffscreenQuickView
leak:QPointingDevice::QPointingDevice
# KWin destroys a removed output's Wayland global five seconds after removing
# it, on a timer its generated globalRemove() arms, and does not free the
# output interfaces at shutdown (above). A session that ends sooner after an
# output goes away leaves that timer: the output session leaks these 88 bytes
# on every run, and none when it waits six seconds after the removal
# (2026-09-28).
leak:KWin::Workspace::outputRemoved
