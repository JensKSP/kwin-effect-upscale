[Unit]
Description=Upscaler helper for Wine and Proton games
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=org.kde.KWin.Upscale.Helper
ExecStart=@KDE_INSTALL_FULL_LIBEXECDIR@/kwin-upscale-helper
Slice=background.slice
