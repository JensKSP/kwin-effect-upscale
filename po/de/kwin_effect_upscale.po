#, kde-format
msgid "X11 buffer request"
msgstr "X11-Pufferanforderung"

#, kde-format
msgid "no resolution request"
msgstr "keine Auflösungsanforderung"

#, kde-format
msgid "advertised screen mode"
msgstr "angekündigter Bildschirmmodus"

#, kde-format
msgid "advertised screen scale"
msgstr "angekündigte Bildschirmskalierung"

#, kde-format
msgid "advertised screen mode and scale"
msgstr "angekündigter Bildschirmmodus und Skalierung"

#, kde-format
msgid "automatic, verified against what the application commits"
msgstr "automatisch, geprüft an dem, was die Anwendung liefert"

#, kde-format
