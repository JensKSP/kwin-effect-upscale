msgstr "OpenGL ES"

#, kde-format
msgid "OpenGL"
msgstr "OpenGL"

#, kde-format
msgctxt "%1 is the pattern, %2 what is wrong with it"
msgid "“%1” is not a valid regular expression: %2"
msgstr "«%1» no es una expresión regular válida: %2"

#, kde-format
msgctxt "%1 is the pattern"
msgid "“%1” matches everything."
msgstr "«%1» coincide con todo."

#, kde-format
msgid "Enable the X11 proxy at login"
msgstr "Activar el proxy X11 al iniciar sesión"

#, kde-format
msgid ""
"Tell recognized X11 games the smaller screen before they create a window. "
"Switching this takes effect at the next login."
msgstr ""
"Indicar la pantalla más pequeña a los juegos X11 reconocidos antes de que "
"creen una ventana. El cambio surte efecto en el próximo inicio de sesión."

#, kde-format
msgid "Log out required: apply, then log out and back in to use the X11 proxy."
msgstr ""
"Hay que cerrar la sesión: aplique, luego cierre la sesión y vuelva a entrar "
"para usar el proxy X11."

#, kde-format
msgid "X11 routing is disabled for the next login."
msgstr "El enrutamiento X11 está desactivado para el próximo inicio de sesión."

#, kde-format
msgid ""
"Log out required: apply, then log out and back in to stop using the X11 "
"proxy. X11 programs already running keep using it until then."
msgstr ""
"Hay que cerrar la sesión: aplique, luego cierre la sesión y vuelva a entrar "
"para dejar de usar el proxy X11. Los programas X11 que ya se están "
"ejecutando lo seguirán usando hasta entonces."

#, kde-format
msgid "This session was configured to use the X11 proxy."
msgstr "Esta sesión se configuró para usar el proxy X11."

#, kde-format
msgid "This session uses Xwayland directly, without the proxy."
msgstr "Esta sesión usa Xwayland directamente, sin el proxy."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "upscaling was switched off."
msgstr "el reescalado se desactivó."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid ""
"the application is not in the list, and “All applications” is switched off."
msgstr ""
"la aplicación no está en la lista y «Todas las aplicaciones» está "
"desactivado."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the screen is at or below the resolution limit."
msgstr "la pantalla está en el límite de resolución o por debajo."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid ""
"a graphics resource could not be created; apply the settings to try again."
msgstr ""
"no se pudo crear un recurso gráfico; aplique los ajustes para volver a "
"intentarlo."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the screen is locked."
msgstr "la pantalla está bloqueada."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "another fullscreen effect is active."
msgstr "hay otro efecto de pantalla completa activo."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window has not supplied a buffer yet."
msgstr "la ventana todavía no ha entregado un búfer."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the supplied buffer is empty."
msgstr "el búfer entregado está vacío."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the supplied buffer is not smaller than the destination."
msgstr "el búfer entregado no es más pequeño que el destino."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the supplied buffer is less than half the destination size."
msgstr "el búfer entregado mide menos de la mitad del tamaño de destino."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the supplied buffer has a different aspect ratio than the destination."
msgstr ""
"el búfer entregado tiene una relación de aspecto distinta de la del destino."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid ""
"the supplied buffer is larger than the destination, so no whole-number "
"multiple of it fits."
msgstr ""
"el búfer entregado es más grande que el destino, por lo que no cabe ningún "
"múltiplo entero de él."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid ""
"the whole-number factor that fits is not two, the only one FSR 1 enlarges by."
msgstr "el factor entero que cabe no es dos, el único por el que amplía FSR 1."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the supplied buffer is rotated or flipped."
msgstr "el búfer entregado está girado o volteado."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "only part of the supplied buffer is displayed."
msgstr "solo se muestra una parte del búfer entregado."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the supplied buffer is not fully opaque."
msgstr "el búfer entregado no es completamente opaco."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the supplied buffer format cannot be read by the scaler."
msgstr "el escalador no puede leer el formato del búfer entregado."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "this frame paints the window or the screen with a transformation."
msgstr "este fotograma dibuja la ventana o la pantalla con una transformación."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "this frame paints the window with reduced opacity."
msgstr "este fotograma dibuja la ventana con opacidad reducida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "this frame paints the window with adjusted brightness or saturation."
msgstr ""
"este fotograma dibuja la ventana con el brillo o la saturación ajustados."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "this frame paints at a different scale than the output."
msgstr "este fotograma dibuja a una escala distinta de la de la salida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid ""
"this frame's render target has an orientation the scaler does not handle."
msgstr ""
"el destino de renderizado de este fotograma tiene una orientación que el "
"escalador no maneja."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "more than one fullscreen window is eligible on this output."
msgstr "hay más de una ventana de pantalla completa elegible en esta salida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "this output's color handling is not supported."
msgstr "no se admite la gestión del color de esta salida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "there is no window to scale."
msgstr "no hay ninguna ventana que escalar."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid ""
"the window is not fullscreen or a selected borderless window covering its "
"output."
msgstr ""
"la ventana no está a pantalla completa ni es una ventana sin bordes "
"seleccionada que cubra su salida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window is closing."
msgstr "la ventana se está cerrando."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window is minimized."
msgstr "la ventana está minimizada."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window is on another virtual desktop."
msgstr "la ventana está en otro escritorio virtual."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window is on another activity."
msgstr "la ventana está en otra actividad."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "another window on its output is active."
msgstr "hay otra ventana activa en su salida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window is translucent."
msgstr "la ventana es translúcida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window is not on an output."
msgstr "la ventana no está en ninguna salida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window has no surface to capture."
msgstr "la ventana no tiene ninguna superficie que capturar."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the output is rotated or flipped."
msgstr "la salida está girada o volteada."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window does not exactly cover its output."
msgstr "la ventana no cubre exactamente su salida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window is being transformed."
msgstr "la ventana se está transformando."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window's surface has child surfaces."
msgstr "la superficie de la ventana tiene superficies hijas."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window's surface is being transformed."
msgstr "la superficie de la ventana se está transformando."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window's surface is offset inside the window."
msgstr "la superficie de la ventana está desplazada dentro de la ventana."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window's surface is translucent."
msgstr "la superficie de la ventana es translúcida."

#, kde-format
msgctxt ""
"A reason, after “Inactive:”, “not scaling:” or “was not scaled because”"
msgid "the window's surface is displayed at a different size than the window."
msgstr ""
"la superficie de la ventana se muestra a un tamaño distinto del de la "
"ventana."

