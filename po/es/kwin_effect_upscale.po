msgstr "Añadir desde una ventana"

#, kde-format
msgid "The window could not be identified: %1"
msgstr "No se pudo identificar la ventana: %1"

#, kde-format
msgid "The window does not identify its application."
msgstr "La ventana no indica su aplicación."

#, kde-format
