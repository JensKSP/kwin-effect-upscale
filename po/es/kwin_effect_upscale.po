#, kde-format
msgid "X11 buffer request"
msgstr "solicitud de búfer X11"

#, kde-format
msgid "no resolution request"
msgstr "sin solicitud de resolución"

#, kde-format
msgid "advertised screen mode"
msgstr "modo de pantalla anunciado"

#, kde-format
msgid "advertised screen scale"
msgstr "escala de pantalla anunciada"

#, kde-format
msgid "advertised screen mode and scale"
msgstr "modo y escala de pantalla anunciados"

#, kde-format
msgid "automatic, verified against what the application commits"
msgstr "automático, comprobado con lo que entrega la aplicación"

#, kde-format
