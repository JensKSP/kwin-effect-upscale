#, kde-format
msgid "X11 buffer request"
msgstr "demande de tampon X11"

#, kde-format
msgid "no resolution request"
msgstr "aucune demande de résolution"

#, kde-format
msgid "advertised screen mode"
msgstr "mode d’écran annoncé"

#, kde-format
msgid "advertised screen scale"
msgstr "échelle d’écran annoncée"

#, kde-format
msgid "advertised screen mode and scale"
msgstr "mode et échelle d’écran annoncés"

#, kde-format
msgid "automatic, verified against what the application commits"
msgstr "automatique, vérifié d’après ce que l’application fournit"

#, kde-format
