#
# Words this project spells correctly that the check reads as mistakes.
#
# codespell's own dictionaries are lists of misspellings, not lists of terms a
# project is allowed to use, so there is no community word list to import that
# would teach it our vocabulary. Its 'code' dictionary is the opposite of what
# the name suggests: it adds corrections for code-like words appearing in
# prose, such as uint. The default 'clear,rare' is what runs here, and a term
# it does not know is taught to it below.
#
# Add a word only when it is right where it stands: a keyword, a term of art, a
# name, or a word of another language that a fixture or quotation needs. Every
# entry switches the check off for that word everywhere in the repository, so a
# word that is simply wrong is corrected in the text instead.
#
# inout  A GLSL storage qualifier, in the FSR shaders this effect compiles.

[codespell]
ignore-words-list = inout
