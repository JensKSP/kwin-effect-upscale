#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Jens Koehler <kwin-effect-upscale@koehler-speyer.de>
# SPDX-License-Identifier: GPL-2.0-or-later

# Reproducible builds: dh exports SOURCE_DATE_EPOCH from the changelog, and the
# build information compiled into the plugin uses it instead of the wall clock.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# debhelper forwards its job limit to Ninja, but not to CTest through Ninja's
# test target. Honour the same package limit unless CTest has its own override.
export CTEST_PARALLEL_LEVEL ?= $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=build

# Warnings are errors for developers, not for whoever is building the package on
# an architecture or compiler version nobody here has tried.
override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_COMPILE_WARNING_AS_ERROR=OFF \
		-DUPSCALE_PACKAGE_VERSION=$(DEB_VERSION)

# KWin's effect ABI is private. Its common package has the version shared by
# the development headers and both compositors; shlibs alone gives no upper bound.
override_dh_gencontrol:
	dh_gencontrol -- -Vkwin:Depends="kwin-common (= $$(dpkg-query -W -f='$${Version}' kwin-common))"
