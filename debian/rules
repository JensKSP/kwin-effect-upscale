#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Jens Koehler <kwin-effect-upscale@koehler-speyer.de>
# SPDX-License-Identifier: GPL-2.0-or-later

# Reproducible builds: dh exports SOURCE_DATE_EPOCH from the changelog, and the
# build information compiled into the plugin uses it instead of the wall clock.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# debhelper forwards its job limit to Ninja, but not to CTest through Ninja's
# test target. Honour the same package limit unless CTest has its own override.
export CTEST_PARALLEL_LEVEL ?= $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=build

# Warnings are errors for developers, not for whoever is building the package on
# an architecture or compiler version nobody here has tried.
#
# No test runs during the package build: the suite runs once afterwards against
# the package this build produced, installed into a clean container. A test that
# passes here and a package that does not work are the same bug found a stage
# too early.
#
# Skipped by the empty override below and not by DEB_BUILD_OPTIONS=nocheck,
# which debhelper answers with -DBUILD_TESTING:BOOL=OFF. That drops autotests/
# from the build altogether, and the test stage needs one binary out of it: the
# probe that loads the installed plugins in a clean container, which has no
# compiler to build it with.
#
# The suite itself runs in the pull request checks, on both architectures,
# against the build tree. It cannot run against an installed effect anywhere a
# package is built: the effect declares itself unsupported without OpenGL, and
# KWin's virtual backend has no DRM device to provide it, which is why the
# session tests drive a module built beside them instead.
#
# UPSCALE_SESSION_TESTS stays off so that the two tests needing a compositor
# session are not registered with CTest. They start a nested kwin_wayland with
# Xwayland and drive a real client through it, and whether that client answers
# inside the effect's three second validation window is a property of the
# machine: beside three other builds it does not, and the failure then describes
# the builder rather than the plugin. The test stage runs them by name, alone,
# against the installed effect, which is the machine they need.
# Built here, run in the test stage. See above.
override_dh_auto_test:

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_COMPILE_WARNING_AS_ERROR=OFF \
		-DUPSCALE_PACKAGE_VERSION=$(DEB_VERSION) \
		-DUPSCALE_SESSION_TESTS=OFF

# KWin's effect ABI is private. Its common package has the version shared by
# the development headers and both compositors; shlibs alone gives no upper bound.
override_dh_gencontrol:
	dh_gencontrol -- -Vkwin:Depends="kwin-common (= $$(dpkg-query -W -f='$${Version}' kwin-common))"
