# Build KDE's own integration tests against the minimum supported compositor.
FROM localhost/upscale-conformance:trixie
RUN apt-get update \
    && apt-get build-dep --no-install-recommends -y kwin \
    && apt-get install --no-install-recommends -y libei-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
