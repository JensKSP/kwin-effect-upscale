# Arch package environment. Arch ships no separate KWin development package:
# the headers and the CMake config are in the kwin package itself.
#
# makepkg refuses to run as root, so the image carries an unprivileged user to
# build as. Everything before that needs root, which is why the user is created
# last and the build entry point switches to it.
#
# This image runs in the nightly and, deliberately, nowhere earlier. Build it
# locally only when working on this platform.
ARG BASE_IMAGE=docker.io/library/archlinux:base-devel
FROM ${BASE_IMAGE}
ARG DEPENDENCY_EPOCH=local
# Laid out so tools/distribution-packages.py finds debian/control where it
# expects it, one directory above itself.
COPY debian/control /tmp/upscale/debian/control
COPY tools/distribution_packages.py tools/distribution-packages.py /tmp/upscale/tools/
WORKDIR /tmp
RUN test -n "$DEPENDENCY_EPOCH" \
    && pacman -Syu --noconfirm --needed git python \
    && pacman -S --noconfirm --needed \
        $(python3 -B /tmp/upscale/tools/distribution-packages.py arch) \
    && pacman -Scc --noconfirm

# What this image installed its build dependencies from. A checkout whose
# debian/control has moved on is told to rebuild, rather than failing later
# on a missing header that names neither the image nor the dependency.
# makepkg will not run as root, and the mounted checkout belongs to whoever
# started the container, so the build user writes only under build/.
RUN sha256sum /tmp/upscale/debian/control > /etc/upscale-dependency-stamp \
    && useradd --create-home --uid 1000 builder
WORKDIR /src
