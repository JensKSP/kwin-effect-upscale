# openSUSE Tumbleweed package environment. Tumbleweed is a rolling
# distribution, so this is the target whose KWin moves under the package
# without warning; the built package pins the exact KWin it saw.
#
# This image runs in the nightly and, deliberately, nowhere earlier. Build it
# locally only when working on this platform.
ARG BASE_IMAGE=docker.io/opensuse/tumbleweed
FROM ${BASE_IMAGE}
ARG DEPENDENCY_EPOCH=local
# Laid out so tools/distribution-packages.py finds debian/control where it
# expects it, one directory above itself.
COPY debian/control /tmp/upscale/debian/control
COPY tools/distribution_packages.py tools/distribution-packages.py /tmp/upscale/tools/
WORKDIR /tmp
# Packages come from openSUSE's own server, downloadcontent.opensuse.org,
# rather than through download.opensuse.org, which hands each request to a
# mirror. On 2026-10-02 the mirror the GitHub runners were sent to served
# aarch64 packages that were missing or did not match the repository's
# checksums, all day, and zypper gives up on a wrong checksum instead of trying
# another mirror. The origin has the same files, signed alike, and the image
# is built at most once a day. libzypp still takes an HTTP error as final: on
# 2026-09-20 the metadata was refused with 403 once. So each step that
# downloads is tried again after a pause, up to four times.
RUN test -n "$DEPENDENCY_EPOCH" \
    && sed -i 's#^baseurl=https\?://download\.opensuse\.org/#baseurl=https://downloadcontent.opensuse.org/#' \
        /etc/zypp/repos.d/*.repo \
    && fetch() { \
        for pause in 30 60 120 -; do \
            "$@" && return; \
            [ "$pause" != - ] || return 1; \
            echo "Trying again in $pause seconds: $*" >&2; \
            sleep "$pause"; \
        done; \
    } \
    && fetch zypper --non-interactive --gpg-auto-import-keys refresh \
    && fetch zypper --non-interactive install --no-recommends \
        gcc-c++ git python3 rpm-build \
    && fetch zypper --non-interactive install --no-recommends \
        $(python3 -B /tmp/upscale/tools/distribution-packages.py opensuse) \
    && zypper clean --all

# What this image installed its build dependencies from. A checkout whose
# debian/control has moved on is told to rebuild, rather than failing later
# on a missing header that names neither the image nor the dependency.
RUN sha256sum /tmp/upscale/debian/control > /etc/upscale-dependency-stamp

WORKDIR /src
