#cloud-config
# SPDX-FileCopyrightText: None
# SPDX-License-Identifier: CC0-1.0
#
# A package machine: Debian with the Plasma desktop its installer offers,
# logged in by SDDM into a Plasma Wayland session, into which the package is
# installed as a user's would be. tools/package-vm.py fills in the @...@ fields
# from keys it makes for each machine; no key is kept in this file.
hostname: upscale-plasma-debian
users:
  - name: tester
    uid: 1000
    groups: [sudo, video, render, audio]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
      - @AUTHORIZED_KEY@
ssh_deletekeys: true
ssh_genkeytypes: [ed25519]
ssh_keys:
  ed25519_private: |
@HOST_KEY_PRIVATE@
  ed25519_public: @HOST_KEY_PUBLIC@
package_update: true
# What Debian's installer puts in place when KDE Plasma is chosen, and the
# games the checks run in the session: SuperTuxKart natively on Wayland,
# Extreme Tux Racer through X11, each with the entry the package ships.
packages: [task-kde-desktop, supertuxkart, extremetuxracer]
write_files:
  - path: /etc/fstab
    append: true
    content: "src /src 9p trans=virtio,version=9p2000.L,msize=1048576,nofail 0 0\n"
  # SDDM logs the tester into Plasma's Wayland session, and again whenever the
  # session ends, which is how a check starts a fresh one.
  - path: /etc/sddm.conf.d/autologin.conf
    content: |
      [Autologin]
      User=tester
      Session=plasma
      Relogin=true
runcmd:
  - mkdir -p /src
  - mount /src
  - systemctl set-default graphical.target
  - systemctl restart sddm
