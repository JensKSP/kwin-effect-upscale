# Newest state: KDE neon unstable, which carries KWin from git master. Used to
# catch API changes early; it is not a supported target.

FROM invent-registry.kde.org/neon/docker-images/plasma:unstable

USER root
ENV DEBIAN_FRONTEND=noninteractive
COPY debian/control /tmp/upscale-debian-control

RUN apt-get update && apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        devscripts \
        equivs \
        clang \
        git \
    && cd /tmp \
    && mk-build-deps --install --remove \
        --tool "apt-get --no-install-recommends -y" upscale-debian-control \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
