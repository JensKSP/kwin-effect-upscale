# Minimum supported environment: plain Debian Trixie, no backports.
# KWin 6.3.6, Qt 6.8.2, KF6/ECM 6.13, GCC 14.2, Clang 19, CMake 3.31.6.

FROM docker.io/library/debian:trixie

ARG DEPENDENCY_EPOCH=local
ENV DEBIAN_FRONTEND=noninteractive
COPY debian/control /tmp/upscale-debian-control
WORKDIR /tmp

RUN test -n "$DEPENDENCY_EPOCH" && apt-get update && apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        clang \
        curl \
        ccache \
        clang-format \
        clang-tidy \
        clang-tools \
        clazy \
        libclang-rt-19-dev \
        git \
        python3 \
        reuse \
        lintian \
        shellcheck \
        llvm \
        devscripts \
        equivs \
        debhelper \
        pipx \
    && mk-build-deps --install --remove \
        --tool "apt-get --no-install-recommends -y" upscale-debian-control \
    && rm -rf /var/lib/apt/lists/*

# What this image installed its build dependencies from. A checkout whose
# debian/control has moved on is told to rebuild, rather than failing later
# on a missing header that names neither the image nor the dependency.
RUN sha256sum /tmp/upscale-debian-control > /etc/upscale-dependency-stamp

# actionlint runs shellcheck over every `run:` block, but only when the binary
# is there: without it, it checks the YAML and silently skips the shell. That
# is how a comment placed between two continued lines of a `gh attestation
# verify` command passed the container's lint while failing the same hook on a
# developer's machine. CI runs its checks in this image, so a check that is
# weaker here is weaker in CI.
# curl fetches the pinned CodeQL command line for the security analysis, which
# is published as a release archive rather than a distribution package.
#
# pre-commit drives every check in this repository and is not packaged in
# Trixie. check-jsonschema validates the KPluginMetaData file; it is a hook
# dependency rather than a package.
RUN PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install pre-commit==4.6.2 \
    && PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install check-jsonschema==0.38.0

# Fail while building the image if either compiler or a supported build
# generator is missing. Project dependencies come from debian/control above.
RUN cmake --version \
    && ninja --version \
    && gcc --version \
    && g++ --version \
    && clang --version \
    && clang++ --version

# Git's local clone subprocess checks this repository directory separately
# from the worktree. The mounted checkout belongs to the host runner's UID.
# No systemd-tmpfiles runs in this image. KWin needs the standard X11 socket
# directory before it can start its private Xwayland integration session.
RUN git config --system --add safe.directory /src/.git \
    && install -d -m 1777 /tmp/.X11-unix

WORKDIR /src
