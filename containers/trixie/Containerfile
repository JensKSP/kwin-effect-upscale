# Minimum supported environment: plain Debian Trixie, no backports.
# KWin 6.3.6, Qt 6.8.2, KF6/ECM 6.13, GCC 14.2, Clang 19, CMake 3.31.6.

FROM docker.io/library/debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
COPY debian/control /tmp/upscale-debian-control

RUN apt-get update && apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        clang \
        clang-format \
        clang-tidy \
        clang-tools \
        clazy \
        libclang-rt-19-dev \
        git \
        python3 \
        reuse \
        lintian \
        devscripts \
        equivs \
        debhelper \
        pipx \
    && cd /tmp \
    && mk-build-deps --install --remove \
        --tool "apt-get --no-install-recommends -y" upscale-debian-control \
    && rm -rf /var/lib/apt/lists/*

# pre-commit drives every check in this repository and is not packaged in
# Trixie. check-jsonschema validates the KPluginMetaData file; it is a hook
# dependency rather than a package.
RUN PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install pre-commit \
    && PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install check-jsonschema

# Fail while building the image if either compiler or a supported build
# generator is missing. Project dependencies come from debian/control above.
RUN cmake --version \
    && ninja --version \
    && gcc --version \
    && g++ --version \
    && clang --version \
    && clang++ --version

WORKDIR /src
