ARG BASE_IMAGE=docker.io/library/debian:trixie
FROM ${BASE_IMAGE}
ARG DEPENDENCY_EPOCH=local
ENV DEBIAN_FRONTEND=noninteractive
COPY debian/control /tmp/upscale-debian-control
WORKDIR /tmp
RUN test -n "$DEPENDENCY_EPOCH" && apt-get update \
    && apt-get install --no-install-recommends -y \
        build-essential ca-certificates devscripts equivs git lintian pipx \
    && mk-build-deps --install --remove \
        --tool "apt-get --no-install-recommends -y" upscale-debian-control \
    && rm -rf /var/lib/apt/lists/*

# What this image installed its build dependencies from. A checkout whose
# debian/control has moved on is told to rebuild, rather than failing later
# on a missing header that names neither the image nor the dependency.
RUN sha256sum /tmp/upscale-debian-control > /etc/upscale-dependency-stamp
# Git's local clone subprocess checks this repository directory separately
# from the worktree. The mounted checkout belongs to the host runner's UID.
RUN PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install pre-commit==4.6.2 \
    && git config --system --add safe.directory /src/.git

# Package-build tests start a private Xwayland without systemd-tmpfiles.
RUN install -d -m 1777 /tmp/.X11-unix

WORKDIR /src
